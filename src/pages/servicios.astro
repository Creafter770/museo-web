---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Servicios" description="Visitas dirigidas, talleres educativos y otros servicios del museo.">
  <h1>Servicios del Museo</h1>
  <p>El museo ofrece los siguientes servicios a la comunidad y a los visitantes:</p>

  <div class="servicios-grid">
    <div class="servicio-card">
      <img
        src="/museo-web/imagenes/servicios/visita-guiada.webp"
        alt="Visitantes recorren una exposición del museo"
        class="servicio-imagen"
      />
      <h3>Visita Guiadas o Libres</h3>
      <p>Recorrido guiado por nuestras salas de historia y naturaleza.</p>
      <p class="precio">Precio: 5 CUP por persona</p>
    </div>

    <div class="servicio-card">
      <img
        src="/museo-web/imagenes/servicios/taller-educativo.webp"
        alt="Taller educativo con estudiantes"
        class="servicio-imagen"
      />
      <h3>Talleres Educativos</h3>
      <p>Actividades para niños y jóvenes orientadas al conocimiento del patrimonio local.</p>
      <a href="/museo-web/eventos" class="boton-eventos">Ver eventos</a>
    </div>
  </div>

  <p class="nota-pago">
    <small>El pago se realiza en taquilla.</small>
  </p>
</BaseLayout>

<style>
  .boton-eventos {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.65rem 1.1rem;
    border-radius: 6px;
    background: var(--color-acento);
    color: white;
    font-weight: bold;
    text-decoration: none;
    transition:
      background-color 0.2s,
      transform 0.2s;
  }

  .boton-eventos:hover {
    background: #6b302d;
    transform: translateY(-2px);
  }

  .boton-eventos:focus-visible {
    outline: 3px solid var(--color-acento);
    outline-offset: 3px;
  }
</style>