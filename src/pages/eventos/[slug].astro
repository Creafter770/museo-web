---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const eventos = await getCollection("eventos");
  return eventos.map((evento) => ({
    params: { slug: evento.id },
    props: { evento },
  }));
}

const { evento } = Astro.props;
const { Content } = await render(evento);
---

<BaseLayout title={evento.data.titulo}>
  <article class="pagina-estatica">
    <p><a href="/eventos">← Volver a eventos</a></p>
    <h1>{evento.data.titulo}</h1>
    <p class="meta">
      <small>
        <strong>Fecha:</strong>
        {evento.data.fecha}
        {evento.data.lugar && ` · ${evento.data.lugar}`}
      </small>
    </p>
    {
      evento.data.imagen && (
        <img
          src={evento.data.imagen}
          alt={evento.data.titulo}
          class="portada"
        />
      )
    }
    <Content />
  </article>
</BaseLayout>

<style>
  .meta {
    color: #666;
    margin-bottom: 1rem;
  }
  .portada {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
</style>
