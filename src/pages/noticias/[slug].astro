---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const noticias = await getCollection("noticias");
  return noticias.map((noticia) => ({
    params: { slug: noticia.id },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
---

<BaseLayout title={noticia.data.titulo}>
  <article class="pagina-estatica">
    <p><a href="/museo-web/noticias">← Volver a noticias</a></p>
    <h1>{noticia.data.titulo}</h1>
    <p class="meta">
      <small
        >{noticia.data.fecha}{
          noticia.data.autor && ` · ${noticia.data.autor}`
        }</small
      >
    </p>
    {
      noticia.data.imagen && (
        <img
          src={noticia.data.imagen}
          alt={noticia.data.titulo}
          class="portada"
        />
      )
    }
    <Content />
  </article>
</BaseLayout>

<style>
  .meta {
    color: #666;
    margin-bottom: 1rem;
  }
  .portada {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
</style>
