---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const contactos = await getCollection('contactos');
---
<BaseLayout title="Contactos" description="Directorio de contactos del Museo Municipal 19 de Diciembre.">
  <h1>Contactos</h1>
  <div class="grid">
    {contactos.map((contacto) => (
      <Card
        titulo={contacto.data.nombre}
        descripcion={contacto.data.bio}
        imagen={contacto.data.foto}
        href={`/museo-web/contactos/${contacto.id}`}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>