---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const ponentes = await getCollection('ponentes');
  return ponentes.map((ponente) => ({
    params: { slug: ponente.id },
    props: { ponente },
  }));
}

const { ponente } = Astro.props;
const { Content } = await render(ponente);
---
<BaseLayout title={ponente.data.nombre}>
  <article>
    <h1>{ponente.data.nombre}</h1>
    <p>{ponente.data.bio}</p>
    {ponente.data.especialidad && <p><strong>Especialidad:</strong> {ponente.data.especialidad}</p>}
    <Content />
  </article>
  <p><a href="/ponentes">← Volver a ponentes</a></p>
</BaseLayout>