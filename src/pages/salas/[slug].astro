---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const salas = await getCollection('salas');
  return salas.map((sala) => ({
    params: { slug: sala.id },
    props: { sala },
  }));
}

const { sala } = Astro.props;
const { Content } = await render(sala);
---
<BaseLayout title={sala.data.titulo} description={sala.data.descripcion} image={sala.data.imagen_principal}>
  <article>
    <p><a href="/museo-web/salas">← Volver a salas</a></p>
    <h1>{sala.data.titulo}</h1>
    <img src={sala.data.imagen_principal} alt={sala.data.titulo} class="portada" />
    <p>{sala.data.descripcion}</p>
    <Content />
  </article>
</BaseLayout>

<style>
  .portada {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
</style>